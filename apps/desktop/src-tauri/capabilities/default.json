{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "The main window: events, web links in the browser, file dialogs, and user-started updates. Nothing else.",
  "windows": ["main"],
  "permissions": [
    "core:event:default",
    "opener:allow-open-url",
    "opener:allow-default-urls",
    "dialog:allow-open",
    "dialog:allow-save",
    "updater:default",
    "process:allow-restart"
  ]
}
