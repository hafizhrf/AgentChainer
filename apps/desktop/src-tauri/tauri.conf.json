{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AgentChainer",
  "version": "0.1.0",
  "identifier": "io.github.hafizhrf.agentchainer",
  "build": {
    "beforeDevCommand": "pnpm --filter @agentchainer/sidecar build:sea && pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm --filter @agentchainer/sidecar build:sea && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AgentChainer",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/agentchainer-sidecar"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
