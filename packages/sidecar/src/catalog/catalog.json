    {
      "id": "gitleaks",
      "name": "Secret scan before each commit (gitleaks)",
      "kind": "hook",
      "tier": "verified-vendor",
      "license": "MIT",
      "homepage": "https://github.com/gitleaks/gitleaks",
      "summary": "Scans staged changes for API keys, tokens and passwords before every commit, on your machine.",
      "why": "Agents write and commit a lot of code quickly. A key pasted into a config file is caught before it reaches the repository, where removing it later means rewriting history and rotating the key.",
      "source": {
        "type": "release-asset",
        "repo": "https://github.com/gitleaks/gitleaks",
        "version": "8.30.1",
        "assets": {
          "darwin-arm64": {
            "url": "https://github.com/gitleaks/gitleaks/releases/download/v8.30.1/gitleaks_8.30.1_darwin_arm64.tar.gz",
            "sha256": "b40ab0ae55c505963e365f271a8d3846efbc170aa17f2607f13df610a9aeb6a5"
          },
          "darwin-x64": {
            "url": "https://github.com/gitleaks/gitleaks/releases/download/v8.30.1/gitleaks_8.30.1_darwin_x64.tar.gz",
            "sha256": "dfe101a4db2255fc85120ac7f3d25e4342c3c20cf749f2c20a18081af1952709"
          },
          "linux-x64": {
            "url": "https://github.com/gitleaks/gitleaks/releases/download/v8.30.1/gitleaks_8.30.1_linux_x64.tar.gz",
            "sha256": "551f6fc83ea457d62a0d98237cbad105af8d557003051f41f3e7ca7b3f2470eb"
          },
          "linux-arm64": {
            "url": "https://github.com/gitleaks/gitleaks/releases/download/v8.30.1/gitleaks_8.30.1_linux_arm64.tar.gz",
            "sha256": "e4a487ee7ccd7d3a7f7ec08657610aa3606637dab924210b3aee62570fb4b080"
          },
          "win32-x64": {
            "url": "https://github.com/gitleaks/gitleaks/releases/download/v8.30.1/gitleaks_8.30.1_windows_x64.zip",
            "sha256": "d29144deff3a68aa93ced33dddf84b7fdc26070add4aa0f4513094c8332afc4e"
          }
        }
      },
      "platforms": [
        "darwin",
        "linux",
        "win32"
      ],
      "requires": [],
      "risk": "low",
      "permissions": [
        "Reads the staged changes of each commit, locally; nothing is sent anywhere",
        "Stops a commit that contains a secret (skip one check with SKIP=gitleaks, or git commit --no-verify)"
      ],
      "secrets": [],
      "install": {
        "scope": "project",
        "steps": [
          {
            "download-binary": {
              "binary": "gitleaks"
            }
          },
          {
            "pre-commit-hook": {
              "id": "gitleaks",
              "run": [
                "{binary}",
                "git",
                "--pre-commit",
                "--staged",
                "--redact",
                "--no-banner"
              ]
            }
          }
        ]
      },
      "uninstall": {
        "steps": [
          {
            "remove": ".agentchainer/hooks/gitleaks.sh"
          }
        ]
      },
      "reviews": [],
      "notes": "Teammates without gitleaks (or AgentChainer) aren't blocked: the committed hook prints a hint and lets the commit through."
    },
